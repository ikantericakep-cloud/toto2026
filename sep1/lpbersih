    document.addEventListener('DOMContentLoaded', function () {
      const AMP_URL = '$$$';
      const modal = document.getElementById('imageModal');
      const modalImg = document.getElementById('modalImage');
      const toast = document.getElementById('toast');

      window.openZoom = function (img) {
        if (!modal || !modalImg || !img) return;
        modal.style.display = 'flex';
        modalImg.src = img.currentSrc || img.src;
      };

      window.closeModal = function () {
        if (modal) modal.style.display = 'none';
      };

      window.changeImage = function (thumbnail) {
        const main = document.getElementById('mainImage');
        if (!main || !thumbnail) return;

        const newSrc = thumbnail.currentSrc || thumbnail.src;
        main.src = newSrc;
        main.srcset = newSrc;

        document.querySelectorAll('.thumbnail').forEach(function (t) {
          t.classList.remove('active');
        });
        thumbnail.classList.add('active');
      };

      window.buyNow = function () {
        window.location.assign(AMP_URL);
      };

      window.addToCart = function () {
        window.location.assign(AMP_URL);
      };

      window.toggleWishlist = function () {
        const icon = document.querySelector('.wishlist-btn i');
        if (!icon) return;
        icon.classList.toggle('far');
        icon.classList.toggle('fas');
        window.showToast(
          icon.classList.contains('fas') ? 'Referensi ditandai' : 'Referensi dibatalkan'
        );
      };

      window.openInfo = function () {
        window.showToast('Informasi BOSANGKA tersedia di halaman ini');
      };

      window.showToast = function (message) {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add('show');
        window.setTimeout(function () {
          toast.classList.remove('show');
        }, 2000);
      };

      window.validateQty = function () {
        const qty = document.getElementById('quantity');
        const error = document.getElementById('quantity-error');
        if (!qty || !error) return;

        let value = parseInt(qty.value, 10);
        if (!Number.isFinite(value) || value < 1) value = 1;

        if (value > 50) {
          value = 50;
          error.textContent = 'Maksimal 50 item';
        } else {
          error.textContent = '';
        }

        qty.value = value;
      };

      window.decreaseQty = function () {
        const qty = document.getElementById('quantity');
        if (!qty) return;
        qty.value = Math.max(1, parseInt(qty.value || '1', 10) - 1);
        window.validateQty();
      };

      window.increaseQty = function () {
        const qty = document.getElementById('quantity');
        if (!qty) return;
        qty.value = Math.min(50, parseInt(qty.value || '1', 10) + 1);
        window.validateQty();
      };

      // Tabs: reliable mouse + keyboard interaction.
      const tabs = document.querySelectorAll('.tab');
      const panes = document.querySelectorAll('.tab-pane');

      function activateTab(tab) {
        const targetId = tab.getAttribute('data-tab');
        if (!targetId) return;

        tabs.forEach(function (t) {
          const selected = t === tab;
          t.classList.toggle('active', selected);
          t.setAttribute('aria-selected', String(selected));
        });

        panes.forEach(function (pane) {
          pane.classList.toggle('active', pane.id === targetId);
        });
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function (event) {
          event.preventDefault();
          activateTab(tab);
        });
      });

      // FAQ: reliable mouse + keyboard interaction.
      function setFaqState(question, open) {
        const item = question.closest('.faq-item');
        const answer = question.nextElementSibling;
        const icon = question.querySelector('i');

        if (!item || !answer) return;

        item.classList.toggle('open', open);
        question.setAttribute('aria-expanded', String(open));
        answer.classList.toggle('show', open);

        if (icon) {
          icon.classList.toggle('fa-chevron-down', !open);
          icon.classList.toggle('fa-chevron-up', open);
        }
      }

      window.toggleFaq = function (question) {
        if (!question) return;
        const expanded = question.getAttribute('aria-expanded') === 'true';
        setFaqState(question, !expanded);
      };

      document.querySelectorAll('.faq-question').forEach(function (question) {
        question.addEventListener('click', function (event) {
          event.preventDefault();
          window.toggleFaq(question);
        });
      });

      // Keep current FAQ open state in sync with the visual class.
      document.querySelectorAll('.faq-question').forEach(function (question) {
        setFaqState(question, question.getAttribute('aria-expanded') === 'true');
      });

      window.askQuestion = function () {
        const field = document.getElementById('faqQuestion');
        const errorDiv = document.getElementById('faqError');
        const successDiv = document.getElementById('faqSuccess');

        if (!field || !errorDiv || !successDiv) return;

        const question = field.value.trim();

        if (!question) {
          errorDiv.style.display = 'block';
          successDiv.style.display = 'none';
          return;
        }

        errorDiv.style.display = 'none';
        successDiv.style.display = 'block';
        field.value = '';

        window.setTimeout(function () {
          successDiv.style.display = 'none';
        }, 3000);

        window.showToast('Pertanyaan Anda telah dikirim');
      };

      window.sortReviews = function () {
        const select = document.getElementById('reviewSort');
        const reviewList = document.getElementById('reviewList');
        if (!select || !reviewList) return;

        const items = Array.from(reviewList.children);

        if (select.value === 'highest') {
          items.sort(function (a, b) {
            return Number(b.dataset.rating) - Number(a.dataset.rating);
          });
        } else if (select.value === 'lowest') {
          items.sort(function (a, b) {
            return Number(a.dataset.rating) - Number(b.dataset.rating);
          });
        }

        items.forEach(function (item) {
          reviewList.appendChild(item);
        });
      };

      if (modal) {
        modal.addEventListener('click', function (event) {
          if (event.target === modal) window.closeModal();
        });
      }

      document.querySelectorAll('.variant-option').forEach(function (option) {
        option.addEventListener('click', function () {
          const parent = option.parentNode;
          if (!parent) return;

          parent.querySelectorAll('.variant-option').forEach(function (item) {
            item.classList.remove('selected');
          });
          option.classList.add('selected');
        });

        option.addEventListener('keydown', function (event) {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            option.click();
          }
        });
      });
    });
  </script>


</body>
