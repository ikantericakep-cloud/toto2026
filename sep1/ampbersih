    /* ===== yunnay ===== */
.yunnay-logo-wrap {
  width: 60px;
  height: 60px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  isolation: isolate;
  perspective: 500px;
  margin-top: 18px;
}

/* gelembung menguap */
.yunnay-logo-wrap::before,
.yunnay-logo-wrap::after {
  content: "";
  position: absolute;
  bottom: 4px;
  left: 50%;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%,
    rgba(232, 213, 221, 0.95),
    rgb(255, 58, 212) 45%,
    rgba(255, 58, 229, 0.08) 75%
  );
  box-shadow:
    -11px -5px 0 -2px rgba(255, 93, 247, 0.75),
    10px -9px 0 -3px rgba(247, 28, 255, 0.72),
    2px -18px 0 -4px rgba(255, 184, 250, 0.55);
  filter: blur(0.2px);
  opacity: 0;
  transform: translateX(-50%) scale(0.4);
  animation: vaporBubble 2.8s ease-in-out infinite;
  z-index: -1;
}

.yunnay-logo-wrap::after {
  animation-delay: 1.35s;
  left: 44%;
  width: 5px;
  height: 5px;
}

.yunnay-logo {
  width: 80px;
  height: auto;
  display: block;
  position: relative;
  z-index: 2;
  transform-origin: center;
  filter:
    drop-shadow(0 0 5px rgba(235, 105, 255, 0.75))
    drop-shadow(0 0 12px rgba(255, 38, 251, 0.38));
  animation:
    trapWarpSpin 4.2s cubic-bezier(.68,-0.55,.27,1.55) infinite,
    trapGlow 2.4s ease-in-out infinite;
  will-change: transform, filter;
}

/* hover: lebih aktif */
.yunnay-logo-wrap:hover .trap-logo {
  animation-duration: 1.5s, 1.2s;
  filter:
    drop-shadow(0 0 7px rgb(255, 105, 230))
    drop-shadow(0 0 18px rgba(248, 38, 255, 0.8));
}

/* animasi warp + squeeze + putar kecil */
@keyframes trapWarpSpin {
  0% {
    transform: rotate(0deg) scale(1) skew(0deg, 0deg);
  }

  18% {
    transform: rotate(8deg) scaleX(1.18) scaleY(0.82) skew(-7deg, 2deg);
  }

  32% {
    transform: rotate(-10deg) scaleX(0.82) scaleY(1.18) skew(6deg, -3deg);
  }

  48% {
    transform: rotateY(180deg) scale(1.05) skew(0deg, 0deg);
  }

  64% {
    transform: rotate(-6deg) scaleX(1.12) scaleY(0.9) skew(4deg, -2deg);
  }

  82% {
    transform: rotate(5deg) scaleX(0.94) scaleY(1.08) skew(-3deg, 2deg);
  }

  100% {
    transform: rotate(0deg) rotateY(360deg) scale(1) skew(0deg, 0deg);
  }
}

/* glow napas */
@keyframes trapGlow {
  0%, 100% {
    filter:
      drop-shadow(0 0 4px rgba(253, 105, 255, 0.55))
      drop-shadow(0 0 9px rgba(255, 38, 244, 0.28));
  }

  50% {
    filter:
      drop-shadow(0 0 8px rgb(246, 126, 255))
      drop-shadow(0 0 20px rgba(255, 38, 255, 0.75));
  }
}

/* bubble naik dan menghilang */
@keyframes vaporBubble {
  0% {
    opacity: 0;
    transform: translate(-50%, 0) scale(0.25);
  }

  20% {
    opacity: 0.9;
  }

  65% {
    opacity: 0.45;
    transform: translate(-65%, -20px) scale(1.15);
  }

  100% {
    opacity: 0;
    transform: translate(-35%, -34px) scale(1.7);
  }
}

