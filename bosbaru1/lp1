      padding-bottom: 12px;
      border: 1px solid rgba(62, 66, 77, 0.6);
      will-change: transform, opacity;
    }

    @keyframes popIn {
      0% {
        opacity: 0;
        transform: scale(0.92) translateY(10px);
      }
      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    /* CONTAINER GAMBAR DENGAN EFEK SHINE RINGAN */
    .image-wrapper {
