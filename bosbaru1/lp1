      position: absolute;
      top: -50%;
      left: -120%;
      width: 60%;
      height: 200%;
      background: linear-gradient(
        120deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.25) 50%,
        rgba(255, 255, 255, 0) 100%
      );
      transform: rotate(25deg);
      animation: imgShine 3.5s infinite ease-in-out;
      pointer-events: none;
    }

    @keyframes imgShine {
      0%, 20% {
        left: -120%;
      }
      70%, 100% {
        left: 180%;
      }
    }

    .clk-btn-sgp {
      width: 100%;
