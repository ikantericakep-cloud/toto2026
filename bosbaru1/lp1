    /* Popup Container (Warna Utama: #1d1d25, #3e424d, #0034ff) */
    .popup-container {
      position: relative;
      width: 90%;
      max-width: 400px;
      background: linear-gradient(145deg, #1d1d25 0%, #292a36 100%);
      border-radius: 16px;
      overflow: hidden;
      text-align: center;
      animation: popIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
